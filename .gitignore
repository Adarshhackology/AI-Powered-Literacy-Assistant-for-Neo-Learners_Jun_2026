# Root GitIgnore for Literacy Assistant

# Frontend node modules and build output
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# Backend virtual environments, node modules and build output
backend/venv/
backend/.venv/
backend/env/
backend/node_modules/
backend/dist/
backend/.env
backend/db.sqlite3
backend/db.sqlite3-journal
backend/__pycache__/
backend/users/__pycache__/
backend/curriculum/__pycache__/
backend/assessments/__pycache__/
backend/config/__pycache__/
backend/*.pyc

# Local IDE files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# OS files
.DS_Store
Thumbs.db
