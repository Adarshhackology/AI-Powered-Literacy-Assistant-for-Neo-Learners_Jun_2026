datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               Int                @id @default(autoincrement())
  username         String             @unique
  email            String             @unique
  password         String
  name             String
  profile          Profile?
  assessmentResults AssessmentResult[]
}

model Profile {
  id                 Int     @id @default(autoincrement())
  userId             Int     @unique
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName           String
  age                String
  gender             String?
  education          String
  occupation         String?
  preferredLanguage  String
  learningGoal       String?
  readingLevel       String?
  writingLevel       String?
  speakingConfidence String?
  dailyLearningTime  String?
  avatar             String?
  xp                 Int     @default(0)
  coins              Int     @default(0)
  streak             Int     @default(0)
  level              Int     @default(1)
  badges             String  @default("[]") // JSON array string
  completedLessons   String  @default("[]") // JSON array string
}

model Lesson {
  id         Int     @id @default(autoincrement())
  title      String
  difficulty String
  time       String
  category   String
  content    String  @db.Text
  audioText  String? @db.Text
  examples   String  @default("[]") // JSON array string of examples
}

model AssessmentResult {
  id                 Int      @id @default(autoincrement())
  userId             Int
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readingScore       Int
  writingScore       Int
  comprehensionScore Int
  overallScore       Int
  completedAt        DateTime @default(now())
}
